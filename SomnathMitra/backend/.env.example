# MongoDB
MONGODB_URI=mongodb://localhost:27017
RAW_DB_NAME=somnath_chatbot
CLEAN_DB_NAME=somnath_clean

# Main LLM (used for chat responses)
# Defaults to local Ollama — swap base URL + key for any OpenAI-compatible provider
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:12b
LLM_API_KEY=ollama

# Intent classifier (lighter model, runs on every request)
INTENT_MODEL=llama3.1:8b

# Embeddings
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3

# RAG retrieval
TOP_K_CHUNKS=5

# Geocoding (Nominatim — set NOMINATIM_URL to a self-hosted instance if preferred)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SomnathMitra/0.1
